{
  "$schema": "./schema/registry.schema.json",
  "schemaVersion": 2,
  "plugins": [
    {
      "id": "dev.deckweave.weather",
      "type": "action",
      "name": "DeckWeave Weather",
      "version": "0.1.0",
      "license": "GPL-3.0-or-later",
      "source": {
        "kind": "workspace",
        "path": "../deckweave/plugins/dev.deckweave.weather.sdPlugin"
      },
      "controllers": [
        "Keypad",
        "Panel"
      ],
      "platforms": [
        "windows"
      ],
      "optional": true,
      "description": "Open-Meteo weather with explicit city selection, current conditions and forecast. No IP geolocation."
    },
    {
      "id": "dev.deckweave.audio",
      "type": "action",
      "name": "DeckWeave Audio",
      "version": "0.1.0",
      "license": "GPL-3.0-or-later",
      "source": {
        "kind": "workspace",
        "path": "../deckweave/plugins/dev.deckweave.audio.sdPlugin"
      },
      "controllers": [
        "Keypad",
        "Encoder",
        "Panel"
      ],
      "platforms": [
        "windows"
      ],
      "optional": true,
      "description": "Windows default-output volume, mute and touch control with observed system state. Requires a native helper in distribution archives.",
      "requiredFiles": [
        {
          "path": "bin/deckweave-system.exe",
          "platforms": [
            "windows"
          ]
        }
      ]
    },
    {
      "id": "dev.deckweave.monitor",
      "type": "action",
      "name": "System Monitor",
      "version": "0.1.0",
      "license": "GPL-3.0-or-later",
      "source": {
        "kind": "workspace",
        "path": "../deckweave/plugins/dev.deckweave.monitor.sdPlugin"
      },
      "controllers": [
        "Keypad",
        "Encoder",
        "Panel"
      ],
      "platforms": [
        "windows"
      ],
      "optional": true,
      "description": "Local CPU, memory and uptime widgets. No network requests."
    },
    {
      "id": "dev.deckweave.timers",
      "type": "action",
      "name": "Timers",
      "version": "0.1.0",
      "license": "GPL-3.0-or-later",
      "source": {
        "kind": "workspace",
        "path": "../deckweave/plugins/dev.deckweave.timers.sdPlugin"
      },
      "controllers": [
        "Keypad",
        "Encoder",
        "Panel"
      ],
      "platforms": [
        "windows"
      ],
      "optional": true,
      "description": "Countdown/focus timer and stopwatch with key, dial and native Panel controls."
    },
    {
      "type": "device",
      "id": "dev.deckweave.mock",
      "name": "DeckWeave Mock Device",
      "version": "0.1.0",
      "license": "GPL-3.0-or-later",
      "description": "Development-only two-instance simulated provider. No physical-output claims; not a public release.",
      "source": {
        "kind": "workspace",
        "path": "../plugin-template/examples/dev.deckweave.mock.dwDevice"
      },
      "deviceProtocol": 1,
      "provisional": true,
      "models": [
        "dev.deckweave.mock.mock"
      ],
      "platforms": [
        "windows",
        "macos",
        "linux"
      ],
      "optional": true
    },
    {
      "id": "dev.deckweave.desktop",
      "type": "action",
      "name": "Desktop Tools",
      "version": "0.1.0",
      "license": "GPL-3.0-or-later",
      "source": {
        "kind": "workspace",
        "path": "../deckweave/plugins/dev.deckweave.desktop.sdPlugin"
      },
      "controllers": [
        "Keypad"
      ],
      "platforms": [
        "windows"
      ],
      "optional": true,
      "description": "Persistent desktop notes, host-owned countdown panels and offline notification sounds. Requires host-services v1; no network or HID access."
    }
  ]
}
